# Secrets Alloy → Grafana Cloud (ne pas committer le vrai .env)
#
# Alloy ne charge PAS ce fichier tout seul. Exporter avant de lancer :
#
# PowerShell :
#   Get-Content .\.env | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -match '^\s*$') { return }
#     $k, $v = $_ -split '=', 2
#     Set-Item -Path "Env:$k" -Value $v.Trim()
#   }
#   alloy run .\config.alloy
#
# Ou manuellement :
#   $env:GRAFANA_CLOUD_USER = "2374545"
#   $env:GRAFANA_CLOUD_TOKEN = "glc_..."
#   alloy run .\config.alloy

GRAFANA_CLOUD_USER=2374545
GRAFANA_CLOUD_TOKEN=glc_REMPLACER_PAR_TON_TOKEN
