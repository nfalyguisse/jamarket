# Copier vers .env pour le développement local :
#   cp .env.example .env
#
# Sur Vercel : Project → Settings → Environment Variables
# (pas besoin de fichier .env sur Vercel)

# URL de l'API Nest (avec le préfixe /api)
# En prod (Vercel) : https://jamarket-api.onrender.com/api
# → utilisée aussi pour Socket.IO (namespace /chat)
API_URL=http://localhost:3000/api

# Origine pour les médias / uploads (sans /api)
# En prod (Vercel) : https://jamarket-api.onrender.com
CDN_URL=http://localhost:3000

# Optionnel — sinon API_URL / CDN_URL sont réutilisés
# DEV_API_URL=http://localhost:3000/api
# DEV_CDN_URL=http://localhost:3000
# STAGING_API_URL=https://staging-api.example.com/api
# STAGING_CDN_URL=https://staging-cdn.example.com
