# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jamarket_db"
# Render (depuis ton PC) : External URL + SSL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/jamarket_db?sslmode=require"

# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4000,http://localhost:4200

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate limiting (Throttler) ──────────────────────────────────────────────
# Limite globale : THROTTLE_LIMIT requêtes / THROTTLE_TTL_MS (ms) par IP.
# Les routes /auth/login, /auth/register, /auth/*/refresh sont plafonnées à 5/min.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/api/uploads

# ─── Seed (prisma db seed) ──────────────────────────────────────────────────
# Obligatoires (local et production)
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=change_me_strong_password
SEED_SUPERADMIN_NAME=Super
SEED_SUPERADMIN_LASTNAME=Admin
# Annonces / users démo : activé par défaut (y compris en prod)
# SEED_INCLUDE_DEMO=false
#
# Sur Render → Pre-Deploy Command (recommandé) :
#   npm run prisma:deploy
# (= migrate deploy + seed idempotent : rôles / catalogue / admin ; démo si pas d’annonces)
#
# Vider / réinitialiser la BDD (local ou Render External URL) :
#   npm run prisma:wipe          # vide les tables
#   npm run prisma:reset         # wipe + seed
#   CONFIRM_DB_WIPE=true npm run prisma:reset   # obligatoire si NODE_ENV=production
#   npm run prisma:migrate:reset # drop + remigre + seed (souvent bloqué sur Render free)