# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jamarket_db"

# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4000,http://localhost:4200

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate limiting (Throttler) ──────────────────────────────────────────────
# Limite globale : THROTTLE_LIMIT requêtes / THROTTLE_TTL_MS (ms) par IP.
# Les routes /auth/login, /auth/register, /auth/*/refresh sont plafonnées à 5/min.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/api/uploads

# ─── Seed (prisma db seed) ──────────────────────────────────────────────────
# Obligatoires en production (NODE_ENV=production)
SEED_SUPERADMIN_EMAIL=admin@jamarket.fr
SEED_SUPERADMIN_PASSWORD=change_me_strong_password
SEED_SUPERADMIN_NAME=Super
SEED_SUPERADMIN_LASTNAME=Admin
# Annonces / users démo : true | false (défaut : true hors prod, false en prod)
# SEED_INCLUDE_DEMO=false
